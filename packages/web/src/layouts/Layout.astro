---
import "../styles/global.css";
---

<script is:inline>
  const getThemePreference = () => {
    if (typeof localStorage !== "undefined" && localStorage.getItem("theme")) {
      return localStorage.getItem("theme");
    }
    return window.matchMedia("(prefers-color-scheme: dark)").matches
      ? "dark"
      : "light";
  };
  const isDark = getThemePreference() === "dark";
  document.documentElement.classList[isDark ? "add" : "remove"]("dark");

  if (typeof localStorage !== "undefined") {
    const observer = new MutationObserver(() => {
      const isDark = document.documentElement.classList.contains("dark");
      localStorage.setItem("theme", isDark ? "dark" : "light");
    });
    observer.observe(document.documentElement, {
      attributes: true,
      attributeFilter: ["class"],
    });
  }
</script>

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.ico" />
    <title>Stremio Premiumize Library</title>
  </head>
  <body>
    <div class="container mx-auto px-1">
      <div class="w-full md:w-2/3 px-1 mx-auto">
        <slot />
      </div>
    </div>
    <!-- put at the bottom of the page -->
    <div
      class="fixed bottom-0 right-0 py-2 px-4 min-h-[20px] m-t-[25px] bg-white text-black md:w-auto w-full text-center"
    >
      <a
        target="_blank"
        href="https://github.com/megadrive/stremio-addon-starter"
        class="hover:underline">Built with Stremio Addon Starter on GitHub</a
      >
    </div>
  </body>

  <style>
    html,
    body {
      margin: 0;
      width: 100%;
      height: 100%;
    }
  </style>
</html>
